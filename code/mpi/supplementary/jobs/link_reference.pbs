#!/bin/bash
#PBS -N B09_link_reference
#PBS -P YOUR_PROJECT
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb:host=cn-005+1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb:host=cn-083
#PBS -l place=scatter
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${PBS_JOBID:?Submit through PBS}"
cd "$PBS_O_WORKDIR"
source ./mpi/runtime_modules.sh
out="results/mpi_supplementary/link_reference_${PBS_JOBID}"
mkdir -p "$out"
exec > >(tee "$out/run.log") 2>&1
trap 'status=$?; echo JOB_EXIT_STATUS=$status' EXIT
qstat -f "$PBS_JOBID" > "$out/qstat_start.txt"
cp "$PBS_NODEFILE" "$out/pbs_nodefile.txt"
module list
python3 mpi/supplementary/run_feedback.py --mode links --out "$out/data"
echo RUN_STATUS=PASSED
